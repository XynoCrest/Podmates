{
  "name": "@podmates/api",
  "version": "0.1.0",
  "private": true,
  "description": "Express API + in-process settlement worker. Settles pod-days with the tree engine; tree replanting; local demo helpers.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "settle": "tsx --env-file-if-exists=.env.local src/scripts/settle.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@podmates/db": "*",
    "@podmates/shared": "*",
    "@podmates/tree-engine": "*",
    "@supabase/supabase-js": "^2.117.3",
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6"
  }
}
