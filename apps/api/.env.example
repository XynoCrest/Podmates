# apps/api — copy to .env.local (or run `npm run env:local` from the repo root,
# which fills these in from `supabase status`). Every key here is validated in src/env.ts.

APP_ENV=local
PORT=4100

# Local Supabase (from `npx supabase status`). In staging/prod these come from the host's env.
SUPABASE_URL=http://127.0.0.1:55321
# SERVER-ONLY. Bypasses RLS. Never put this in the mobile app.
SUPABASE_SECRET_KEY=

# Run the settlement worker inside this process. It settles every pod-day that has ended.
RUN_WORKER=true
SETTLE_POLL_MS=60000

# Comma-separated browser origins allowed by CORS (Expo web). Native apps don't need this.
CORS_ORIGINS=http://localhost:8081
LOG_LEVEL=info
