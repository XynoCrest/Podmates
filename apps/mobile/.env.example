# apps/mobile — copy to .env.local, or run `npm run env:local` at the repo root.
# EVERYTHING here is compiled into the app and readable by anyone. Never put a secret
# behind EXPO_PUBLIC_. Validated at startup in src/lib/env.ts.

EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# Supabase PUBLISHABLE key (sb_publishable_…). Never the secret key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=http://127.0.0.1:4100
